# ==========================================================
# FindTechBD E-Commerce — Environment Variables (.env)
# ==========================================================

# 1. Server Port (for Render, Railway, VPS, or Localhost)
PORT=8080

# 2. Phone OTP Verification Secret & SMS Gateway (BulkSMSBD / AlphaSMS / GreenWeb)
# (Note: You can also configure SMS Gateway API Key directly from Admin Panel -> Settings)
OTP_SECRET=replace-with-a-random-secret-string
SMS_PROVIDER=bulksmsbd
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=8809617611000
SMS_BRAND_NAME=FindTechBD

# 3. Order Confirmation Email (Optional — Gmail SMTP or Resend)
EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=FindTechBD

# 4. Optional Firebase Firestore Cloud Database (Falls back to data/db.json automatically if left blank)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
